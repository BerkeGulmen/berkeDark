# ---------------------------------------------------------------- commands

def cmd_install(targets: list[str], dry: bool) -> int:
    record = Record(dry)
    failed = 0
    with tempfile.TemporaryDirectory(prefix="berkeDark-") as work:
        tree = build_tree(Path(work))
        for target in targets:
            try:
                failed += bool(INSTALLERS[target](tree, record))
            except Refusal as why:
                say("NOT CHANGED", "", str(why))
                failed += 1
            except (OSError, UnicodeDecodeError) as why:
                say("NOT DONE", "", f"{target}: {why}")
                failed += 1
            finally:
                record.save()
    print("Dry run: nothing was changed." if dry else
          "Done. Open a new terminal window; windows and programs already open keep what they had.")
    if failed:
        print(f"{failed} of the targets were not done completely; the lines above in capitals say why.")
    return 1 if failed else 0


def before_uninstall_name(path: Path) -> Path:
    stamp = time.strftime("%Y%m%d-%H%M%S")
    saved, n = path.with_name(f"{path.name}.berkeDark-before-uninstall-{stamp}"), 1
    while saved.exists() or saved.is_symlink():
        n += 1
        saved = path.with_name(f"{path.name}.berkeDark-before-uninstall-{stamp}-{n}")
    return saved


def undo_file(record: Record, key: str, dry: bool) -> bool:
    """Takes berkeDark out of one file. Returns whether the record's copy of the file can go."""
    entry, path = record.data["files"][key], Path(key)
    real = real_path(path)
    current = real.read_bytes() if real.exists() else None
    backup = STATE / "backups" / entry["backup"] if entry.get("backup") else None
    old = backup.read_bytes() if backup else None
    changed = current is not None and entry.get("written") and sha(current) != entry["written"]
    if current is None:
        if old is not None and real.parent.is_dir():
            if not dry:
                put(real, old, mode=backup.stat().st_mode & 0o7777)
            say("would restore" if dry else "restored", path, "it was missing")
        elif old is not None:
            say("kept", backup, f"{path} and its folder are gone, so it is not put back; this is the file as it was")
            return False
        else:
            say("gone", path, "nothing to do")
        return True
    if entry["existed"] and not old:
        say("left", path, "it was already like this before berkeDark")
        return True
    if current is not None and not os.access(real, os.W_OK):
        raise Refusal("it is read-only; make it writable and run uninstall again")
    # A settings file: berkeDark's keys go back one by one, unless the file is still exactly what berkeDark's
    # one change made of the copy (then the copy comes back byte for byte).
    exact = not changed and entry.get("from", "?") == (sha(old) if old is not None else None)
    if changed:
        saved = before_uninstall_name(path)
        if not dry:
            shutil.copy2(real, saved)
        say("would save" if dry else "saved", saved, "this file changed after berkeDark wrote it")
    if "keys" in entry and not exact:
        new, notes = UNMERGE[entry["format"]](path, current.decode("utf-8"), entry["keys"], not entry["existed"])
        if new is None:
            if not dry:
                path.unlink()
            say("would remove" if dry else "removed", path, "berkeDark made it and nothing else is in it")
        elif new.encode() == current:
            say("left", path, "; ".join(notes) or "nothing of berkeDark's in it")
        else:
            if not dry:
                put(real, new.encode())
            say("would undo" if dry else "undone", path, "berkeDark's keys as they were; the rest as it is now" +
                ("; " + "; ".join(notes) if notes else ""))
    elif old is not None:
        if not dry:
            put(real, old, mode=backup.stat().st_mode & 0o7777)
            os.utime(real, ns=(backup.stat().st_atime_ns, backup.stat().st_mtime_ns))
        say("would restore" if dry else "restored", path)
    else:
        if not dry:
            path.unlink()
        say("would remove" if dry else "removed", path)
    return True


def cmd_uninstall(targets: list[str], dry: bool) -> int:
    record = Record(dry)
    files = record.data["files"]
    count = failed = 0
    for key in sorted(k for k, v in files.items() if v["target"] in targets):
        try:
            drop_copy = undo_file(record, key, dry)
        except (Refusal, OSError, UnicodeDecodeError) as why:
            say("NOT RESTORED", key, str(why))
            failed += 1
            continue
        count += 1
        if dry:
            continue
        backup = files[key].get("backup")
        del files[key]
        record.save()  # the record no longer names the copy; only now may it go
        if backup and drop_copy:
            (STATE / "backups" / backup).unlink(missing_ok=True)
    for folder in sorted((d for d, t in record.data["dirs"].items() if t in targets), key=len, reverse=True):
        p = Path(folder)
        if p.is_dir() and not any(p.iterdir()):
            if not dry:
                p.rmdir()
            say("would remove" if dry else "removed", p, "an empty folder berkeDark made")
        if not dry:
            del record.data["dirs"][folder]
    record.save()
    if not dry and not files and not record.data["dirs"]:
        record.path.unlink(missing_ok=True)
        for p in (STATE / "backups", STATE):  # only what is empty: a copy the record does not name stays
            if p.is_dir() and not any(p.iterdir()):
                p.rmdir()
        if STATE.exists():
            say("kept", STATE, "it holds copies berkeDark no longer lists; look at them, then remove the folder")
        else:
            for folder in record.data.get("state_dirs", []):
                p = Path(folder)
                if p.is_dir() and not any(p.iterdir()):
                    p.rmdir()
    if dry:
        print("Dry run: nothing was changed.")
    else:
        print(f"{count} files done." + (f" {failed} could not be put back; see NOT RESTORED above, then run uninstall"
                                         " again." if failed else ""))
    return 1 if failed else 0


def cmd_status() -> int:
    record = Record(True)
    if not record.data["files"]:
        print("berkeDark has installed nothing (no record in " + str(STATE) + ").")
        return 0
    for key, entry in sorted(record.data["files"].items()):
        path = Path(key)
        state = "missing" if not path.exists() else (
            "as installed" if sha(path.read_bytes()) == entry.get("written") else "changed since")
        print(f"  {entry['target']:<9} {state:<13} {key}")
    return 0


def cmd_settings() -> int:
    if SETTINGS_FILE.exists():
        print(f"Your settings file is already there: {SETTINGS_FILE}")
        return 0
    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(SETTINGS_TEMPLATE, encoding="utf-8")
    print(f"Created {SETTINGS_FILE}: change a colour there, then run ./berkedark install")
    return 0


def main() -> int:
    if sys.argv[1:2] == ["qwen-diff-patch"]:  # its arguments go to the patch as they are
        return subprocess.run([sys.executable, str(REPO / "cli/qwen/reapply-diff-color-patch.py"), *sys.argv[2:]]).returncode
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], epilog=__doc__.split("\n\n", 1)[1],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=["install", "uninstall", "status", "settings", "qwen-diff-patch"])
    parser.add_argument("targets", nargs="*", help="targets (all when none is named); for qwen-diff-patch its arguments")
    parser.add_argument("--dry-run", action="store_true", help="say what would change; change nothing")
    args, rest = parser.parse_known_args()
    if rest:
        parser.error(f"unknown arguments {rest}")
    unknown = [t for t in args.targets if t not in TARGETS]
    if unknown:
        parser.error(f"unknown targets {unknown}; the targets are {', '.join(TARGETS)}")
    targets = args.targets or TARGETS
    if args.command == "install":
        return cmd_install(targets, args.dry_run)
    if args.command == "uninstall":
        return cmd_uninstall(targets, args.dry_run)
    if args.command == "status":
        return cmd_status()
    return cmd_settings()


if __name__ == "__main__":
    sys.exit(main())
