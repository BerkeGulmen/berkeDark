class Refusal(Exception):
    """berkeDark will not change this file; the message says why and what to do instead."""


# ---------------------------------------------------------------- files: reading, writing, links

def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def current_umask() -> int:
    mask = os.umask(0)
    os.umask(mask)
    return mask


def real_path(path: Path) -> Path:
    """The file a path names. A symbolic link (stow, chezmoi and the like) is followed, so that berkeDark writes
    the file the link points to and the link stays a link."""
    if not path.is_symlink():
        return path
    real = Path(os.path.realpath(path))
    if not real.exists():
        raise Refusal(f"{path} is a link to {real}, which is missing; berkeDark changes nothing there")
    return real


def read_text(path: Path) -> str:
    """The file as text, its line ends as they are (CRLF stays CRLF)."""
    try:
        return path.read_bytes().decode("utf-8")
    except UnicodeDecodeError:
        raise Refusal(f"{path} is not UTF-8 text; berkeDark changes nothing in it")


def split_lines(text: str) -> tuple[list[str], str, bool]:
    """The lines of a text, the line end it uses and whether it ends with one. Only \\n and \\r\\n end a line."""
    if not text:
        return [], "\n", True
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.split("\n")
    if nl == "\r\n":
        lines = [line[:-1] if line.endswith("\r") else line for line in lines]
    final = text.endswith("\n")
    if final:
        lines.pop()
    return lines, nl, final


def atomic_write(path: Path, data: bytes, mode: int):
    handle, tmp = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(handle, "wb") as out:
            out.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def put(path: Path, data: bytes, executable: bool = False, mode: int | None = None):
    """Writes data to path, a real file (not a link). A new file gets 0666 (0777 when executable) less the
    umask; an existing one keeps its mode (with x bits added where it has r bits, when executable); mode, when
    given, is used as it is. A file with other hard links is written in place, so that the links stay."""
    if path.exists():
        info = path.stat()
        if mode is None:
            mode = info.st_mode & 0o7777
            if executable:
                mode |= (mode & 0o444) >> 2
        if info.st_nlink > 1:
            with open(path, "r+b") as out:
                out.write(data)
                out.truncate()
                out.flush()
                os.fsync(out.fileno())
            os.chmod(path, mode)
            return
    elif mode is None:
        mode = (0o777 if executable else 0o666) & ~current_umask()
    atomic_write(path, data, mode)


def say(state: str, path: Path | str, note: str = ""):
    print(f"  {state:<13} {path}{('  (' + note + ')') if note else ''}")


# ---------------------------------------------------------------- the record of what berkeDark changed

class Record:
    """manifest.json: for each file berkeDark wrote, whether it existed, where its old bytes are kept, the hash
    of what berkeDark wrote and of what was there just before; for a settings file, each key berkeDark set and
    its value before; and the folders berkeDark created. It is saved after every change, before and after the
    file is written, so that a crash part-way never leaves a kept copy or a changed file unlisted."""

    def __init__(self, dry: bool):
        self.dry = dry
        self.path = STATE / "manifest.json"
        self.data = {"files": {}, "dirs": {}, "state_dirs": []}
        if self.path.exists():
            try:
                self.data = json.loads(self.path.read_text(encoding="utf-8"))
                if not isinstance(self.data, dict) or not isinstance(self.data.get("files"), dict):
                    raise ValueError("it is not berkeDark's record")
            except (OSError, ValueError) as error:
                raise SystemExit(
                    f"berkeDark: its record {self.path} cannot be read ({error}).\n"
                    f"It lists the files berkeDark changed; the copies of your files as they were are in {STATE / 'backups'}.\n"
                    f"Repair it, or move it aside (mv {self.path} {self.path}.broken) and berkeDark starts a new record,\n"
                    "taking the files as it finds them; then put back by hand what you need from the copies.")
            self.data.setdefault("dirs", {})
            self.data.setdefault("state_dirs", [])
        else:  # the folders made for the record go again with the last uninstall
            p = STATE.parent
            while not p.exists():
                self.data["state_dirs"].append(str(p))
                p = p.parent

    def save(self):
        if self.dry or (not self.path.exists() and not self.data["files"] and not self.data["dirs"]):
            return
        STATE.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(tmp, self.path)

    def ensure_dir(self, target: str, folder: Path):
        missing = []
        p = folder
        while not p.exists():
            missing.append(p)
            p = p.parent
        if self.dry:
            return
        for d in reversed(missing):
            d.mkdir()
            self.data["dirs"].setdefault(str(d), target)

    def keep(self, key: str, real: Path) -> str:
        """Copies the file as it is into the backups folder, under a name no other copy has."""
        backups = STATE / "backups"
        backups.mkdir(parents=True, exist_ok=True)
        base = sha(key.encode())[:16] + "-" + Path(key).name
        listed = {entry.get("backup") for entry in self.data["files"].values()}
        name, n = base, 1
        while name in listed or (backups / name).exists():
            n += 1
            name = f"{base}.{n}"
        shutil.copy2(real, backups / name)
        return name

    def write(self, target: str, path: Path, data: bytes, executable: bool = False,
              edit: tuple[str, dict] | None = None) -> str:
        """Writes data to path, keeping the old file the first time it is changed. edit, for a settings file in
        which berkeDark sets only some keys: (format, {key: what it was before}), kept the first time each key
        is set, so that uninstall can put back just those keys. Returns created, changed or unchanged."""
        key = str(path)
        real = real_path(path)
        old = real.read_bytes() if real.exists() else None
        entry = self.data["files"].get(key)
        if old == data:
            if self.dry:
                return "unchanged"
            if entry is None:
                # Already as wanted, though not by berkeDark's hand: recorded so that uninstall leaves it as found.
                entry = self.data["files"][key] = {"target": target, "existed": True, "backup": None,
                                                   "written": sha(data)}
                if edit:
                    entry["format"], entry["keys"] = edit[0], dict(edit[1])
            else:
                if edit and "keys" in entry:
                    for name, before in edit[1].items():
                        entry["keys"].setdefault(name, before)
                if entry.get("written") != sha(data):  # as berkeDark wants it, though not as berkeDark last wrote it
                    entry["written"] = sha(data)
                    entry.pop("from", None)
            self.save()
            return "unchanged"
        if old is not None and not os.access(real, os.W_OK):
            raise Refusal(f"{path} is read-only; berkeDark changes nothing in it (make it writable to let it)")
        if self.dry:
            return "would change" if old is not None else "would create"
        if entry is None:
            entry = self.data["files"][key] = {"target": target, "existed": old is not None, "backup": None}
            if edit:
                entry["format"], entry["keys"] = edit[0], {}
        if old is not None and entry["existed"] and not entry.get("backup"):
            entry["backup"] = self.keep(key, real)  # the first time berkeDark actually changes this file
        if edit and "keys" in entry:
            for name, before in edit[1].items():
                entry["keys"].setdefault(name, before)
        if real != path:
            entry["real"] = str(real)
        self.ensure_dir(target, real.parent)
        self.save()  # the record names the kept copy before the file changes
        put(real, data, executable=executable)
        entry["written"] = sha(data)
        entry["from"] = sha(old) if old is not None else None
        self.save()
        return "changed" if old is not None else "created"


# ---------------------------------------------------------------- the pool, with the user's changes

def build_tree(work: Path) -> Path:
    """A copy of berkeDark's sources in work, its files written from the pool with the user's settings applied."""
    tree = work / "tree"
    shutil.copytree(REPO / "pool", tree / "pool", ignore=shutil.ignore_patterns("build", "__pycache__"))
    shutil.copytree(REPO / "terminal", tree / "terminal", ignore=shutil.ignore_patterns("build", "__pycache__"))
    shutil.copytree(REPO / "cli", tree / "cli", ignore=shutil.ignore_patterns("__pycache__"))
    if SETTINGS_FILE.exists():
        apply_settings(tree / "pool" / "pool.json")
    done = subprocess.run([sys.executable, str(tree / "pool/tools/generate.py")], capture_output=True, text=True)
    if done.returncode != 0:
        raise SystemExit("berkeDark: writing the files from the pool failed:\n" + done.stdout + done.stderr)
    return tree


HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def apply_settings(pool_file: Path):
    if tomllib is None:
        raise SystemExit("berkeDark: reading your settings file needs Python 3.11 or later")
    try:
        settings = tomllib.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as error:
        raise SystemExit(f"berkeDark: {SETTINGS_FILE} is not valid TOML: {error}")
    pool = json.loads(pool_file.read_text(encoding="utf-8"))
    unknown = set(settings) - {"palette", "roles"}
    if unknown:
        raise SystemExit(f"berkeDark: {SETTINGS_FILE}: unknown sections {sorted(unknown)}; only [palette] and [roles]")
    changes = []
    for name, value in settings.get("palette", {}).items():
        if not isinstance(value, str) or not HEX.match(value):
            raise SystemExit(f"berkeDark: {SETTINGS_FILE}: palette {name} = {value!r} is not #rrggbb")
        entry = pool["palette"].setdefault(name, {"tr": name, "from": "the user's settings"})
        entry["hex"] = value.lower()
        changes.append(f"palette {name} {value.lower()}")
    for name, value in settings.get("roles", {}).items():
        if name not in pool["roles"]:
            raise SystemExit(f"berkeDark: {SETTINGS_FILE}: there is no class {name!r} in the pool")
        if not isinstance(value, dict) or set(value) - {"fg", "bg", "style"}:
            raise SystemExit(f"berkeDark: {SETTINGS_FILE}: class {name} takes only fg, bg and style")
        role = pool["roles"][name]
        for side in ("fg", "bg"):
            if side not in value:
                continue
            colour = value[side]
            if isinstance(colour, str) and HEX.match(colour):
                pool["palette"].setdefault("user-" + colour[1:].lower(), {"hex": colour.lower(), "tr": colour.lower(),
                                                                          "from": "the user's settings"})
                colour = "user-" + colour[1:].lower()
            if colour not in pool["palette"]:
                raise SystemExit(f"berkeDark: {SETTINGS_FILE}: class {name}: {value[side]!r} is no palette colour and no #rrggbb")
            role[side] = colour
        if "style" in value:
            styles = value["style"]
            if not isinstance(styles, list) or set(styles) - {"bold", "italic", "underline", "strike"}:
                raise SystemExit(f"berkeDark: {SETTINGS_FILE}: class {name}: style lists bold, italic, underline, strike")
            role["style"] = styles
        changes.append(f"class {name}")
    pool_file.write_text(json.dumps(pool, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"Your settings ({SETTINGS_FILE}): " + (", ".join(changes) if changes else "nothing changed"))


# ---------------------------------------------------------------- settings files: only berkeDark's keys
#
# Each format has a merge (set berkeDark's keys; returns the new text and, per key, what it was before) and an
# unmerge (put back those keys in the file as it is now; returns the new text, or None when berkeDark made the
# file and nothing else is left in it, and notes). Both check their result by parsing it.

def json_layout(text: str | None) -> tuple:
    """The indentation (None: all on one line), line end and final line end a JSON file uses."""
    if text is None:
        return 2, "\n", True
    lines, nl, final = split_lines(text.strip())
    if len(lines) <= 1:
        return None, nl, text.endswith("\n")
    for line in lines[1:]:
        found = re.match(r"^([ \t]+)\S", line)
        if found:
            return found.group(1), nl, text.endswith("\n")
    return 2, nl, text.endswith("\n")


def dump_json(data, layout) -> str:
    indent, nl, final = layout
    text = json.dumps(data, indent=indent, ensure_ascii=False)  # a newline inside a string is written as \n
    return text.replace("\n", nl) + (nl if final else "")


def load_json(path: Path, text: str, keys) -> dict:
    try:
        data = json.loads(text)
    except ValueError:
        raise Refusal(f"{path} is not plain JSON (comments?); set {fmt_keys(keys)} yourself")
    if not isinstance(data, dict):
        raise Refusal(f"{path} is not a JSON object; set {fmt_keys(keys)} yourself")
    return data


def merge_json(path: Path, keys: dict[tuple[str, ...], object]) -> tuple[bytes, dict]:
    """The settings file with only the given keys set; everything else as it was, in the file's own indentation
    (an object written on one line inside a spread-out file comes out spread out). Refuses a file that is not a
    JSON object (a file with comments, too: rewriting it would lose them)."""
    text = read_text(path) if path.exists() else None
    data = load_json(path, text, keys) if text is not None else {}
    before = json.loads(json.dumps(data))
    records = {}
    for key, value in keys.items():
        node, created = data, []
        for i, part in enumerate(key[:-1]):
            if part not in node:
                created.append(list(key[:i + 1]))
                node[part] = {}
            elif not isinstance(node[part], dict):
                raise Refusal(f"{path}: {'.'.join(key[:i + 1])} is not an object; set {fmt_keys(keys)} yourself")
            node = node[part]
        records[".".join(key)] = {"path": list(key), "value": value, "had": key[-1] in node,
                                  "old": node.get(key[-1]), "parents": created}
        node[key[-1]] = value
    out = dump_json(data, json_layout(text))
    check = json.loads(out)
    for key in keys:  # everything else unchanged
        drop(check, key)
        drop(before, key)
    if strip_empty(check) != strip_empty(before):
        raise Refusal(f"{path}: merging would change more than berkeDark's keys")
    return out.encode(), records


def unmerge_json(path: Path, text: str, records: dict, created: bool) -> tuple[str | None, list[str]]:
    data = load_json(path, text, {})
    before = json.loads(json.dumps(data))
    notes, undone = [], []
    for name, rec in records.items():
        node = data
        for part in rec["path"][:-1]:
            node = node.get(part) if isinstance(node, dict) else None
        last = rec["path"][-1]
        if not isinstance(node, dict) or last not in node:
            notes.append(f"{name} is gone already")
            continue
        if node[last] != rec["value"]:
            notes.append(f"{name} was changed since; left as it is")
            continue
        if rec["had"]:
            node[last] = rec["old"]
        else:
            del node[last]
        undone.append(rec)
        for parent in reversed(rec.get("parents", [])):  # the objects berkeDark made for the key, when empty
            holder = data
            for part in parent[:-1]:
                holder = holder.get(part, {})
            if isinstance(holder, dict) and holder.get(parent[-1]) == {}:
                del holder[parent[-1]]
    check = json.loads(json.dumps(data))
    for rec in undone:
        drop(check, tuple(rec["path"]))
        drop(before, tuple(rec["path"]))
    if strip_empty(check) != strip_empty(before):
        raise Refusal(f"{path}: putting back berkeDark's keys would change more than those keys")
    if created and not data:
        return None, notes
    return dump_json(data, json_layout(text)), notes


def drop(node: dict, key: tuple[str, ...]):
    for part in key[:-1]:
        node = node.get(part, {})
        if not isinstance(node, dict):
            return
    node.pop(key[-1], None)


def strip_empty(node):
    if isinstance(node, dict):
        return {k: strip_empty(v) for k, v in node.items() if not (isinstance(v, dict) and not strip_empty(v))}
    return node


def fmt_keys(keys) -> str:
    return ", ".join(".".join(k) + " = " + json.dumps(v) for k, v in keys.items())


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return json.dumps(value)


def toml_section(lines: list[str], section: str) -> tuple[int, int] | None:
    """Where [section] starts and where the next table starts, or None."""
    header = re.compile(r"^\s*\[\s*" + re.escape(section) + r"\s*\]\s*(#.*)?$")
    starts = [i for i, line in enumerate(lines) if header.match(line)]
    if not starts:
        return None
    start = starts[0]
    end = next((i for i in range(start + 1, len(lines)) if re.match(r"^\s*\[", lines[i])), len(lines))
    return start, end


def toml_key_line(lines: list[str], start: int, end: int, key: str) -> int | None:
    key_line = re.compile(r"^\s*" + re.escape(key) + r"\s*=")
    return next((i for i in range(start + 1, end) if key_line.match(lines[i])), None)


def load_toml(path: Path, text: str, keys) -> dict:
    if tomllib is None:
        raise Refusal(f"editing {path} needs Python 3.11 or later; set {fmt_keys(keys)} yourself")
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise Refusal(f"{path} is not valid TOML ({error}); set {fmt_keys(keys)} yourself")


def merge_toml(path: Path, keys: dict[tuple[str, str], object]) -> tuple[bytes, dict]:
    """The TOML file with only [section] key = value set for the given keys, edited line by line so that
    comments, order and line ends stay; checked by parsing before and after."""
    text = read_text(path) if path.exists() else ""
    before = load_toml(path, text, keys)
    lines, nl, _ = split_lines(text)
    records = {}
    for (section, key), value in keys.items():
        current = before.get(section)
        if current is not None and not isinstance(current, dict):
            raise Refusal(f"{path}: {section} is not a table; set {section}.{key} yourself")
        line_text = f"{key} = {toml_value(value)}"
        found = toml_section(lines, section)
        if found is None:
            if current is not None:  # the table is written another way (dotted keys, inline): not ours to rewrite
                raise Refusal(f"{path}: {section} is not written as a [{section}] table; set {section}.{key} yourself")
            if lines and lines[-1].strip():
                lines.append("")
            lines += [f"[{section}]", line_text]
            records[f"{section}.{key}"] = {"section": section, "key": key, "value": value, "had": False,
                                           "line": None, "new_section": True}
            continue
        start, end = found
        at = toml_key_line(lines, start, end, key)
        records[f"{section}.{key}"] = {"section": section, "key": key, "value": value, "had": at is not None,
                                       "line": lines[at] if at is not None else None, "new_section": False}
        if at is not None:
            lines[at] = line_text
        else:
            at = end
            while at > start + 1 and not lines[at - 1].strip():
                at -= 1
            lines.insert(at, line_text)
    out = nl.join(lines) + nl
    try:
        after = tomllib.loads(out)
    except tomllib.TOMLDecodeError as error:
        raise Refusal(f"{path}: the edited file would not be valid TOML ({error}); nothing changed")
    for (section, key), value in keys.items():
        if after.get(section, {}).get(key) != value:
            raise Refusal(f"{path}: {section}.{key} did not take the value; nothing changed")
        after.get(section, {}).pop(key, None)
        if section in before:
            before[section].pop(key, None)
    if strip_empty(after) != strip_empty(before):
        raise Refusal(f"{path}: editing would change more than berkeDark's keys; nothing changed")
    return out.encode(), records


def unmerge_toml(path: Path, text: str, records: dict, created: bool) -> tuple[str | None, list[str]]:
    before = load_toml(path, text, {})
    lines, nl, final = split_lines(text)
    notes, undone = [], []
    for name, rec in records.items():
        found = toml_section(lines, rec["section"])
        at = toml_key_line(lines, *found, rec["key"]) if found else None
        if at is None:
            notes.append(f"{name} is gone already")
            continue
        try:
            value = tomllib.loads(lines[at]).get(rec["key"])
        except tomllib.TOMLDecodeError:
            value = None
        if value != rec["value"]:
            notes.append(f"{name} was changed since; left as it is")
            continue
        undone.append(rec)
        if rec["had"]:
            lines[at] = rec["line"]
            continue
        del lines[at]
        start, end = toml_section(lines, rec["section"])
        if rec["new_section"] and not any(line.strip() for line in lines[start + 1:end]):
            del lines[start:end]  # the table berkeDark made, now empty
            if start == len(lines) and start > 0 and not lines[start - 1].strip():
                del lines[start - 1]  # and the empty line berkeDark put before it
    out = nl.join(lines) + (nl if lines and final else "")
    try:
        after = tomllib.loads(out)
    except tomllib.TOMLDecodeError as error:
        raise Refusal(f"{path}: putting back berkeDark's keys would leave invalid TOML ({error}); nothing changed")
    for rec in undone:
        section, key = rec["section"], rec["key"]
        try:
            wanted = tomllib.loads(rec["line"]).get(key) if rec["had"] else None
        except tomllib.TOMLDecodeError as error:
            raise Refusal(f"{path}: the old line of {section}.{key} does not read alone ({error}); nothing changed")
        if after.get(section, {}).get(key) != wanted:
            raise Refusal(f"{path}: {section}.{key} did not go back; nothing changed")
        after.get(section, {}).pop(key, None)
        before.get(section, {}).pop(key, None)
    if strip_empty(after) != strip_empty(before):
        raise Refusal(f"{path}: putting back berkeDark's keys would change more than those keys; nothing changed")
    if created and not any(line.strip() for line in lines):
        return None, notes
    return out, notes


def unmerge_line(path: Path, text: str, records: dict, created: bool) -> tuple[str | None, list[str]]:
    """A line berkeDark replaced (ZSH_THEME in .zshrc): the old line back, when berkeDark's is still there."""
    lines, nl, final = split_lines(text)
    notes = []
    for name, rec in records.items():
        found = [i for i, line in enumerate(lines) if re.match(r"^\s*" + re.escape(name) + "=", line)]
        if not found:
            notes.append(f"{name} is gone already")
        elif lines[found[0]] != rec["value"]:
            notes.append(f"{name} was changed since; left as it is")
        else:
            lines[found[0]] = rec["line"]
    return nl.join(lines) + (nl if lines and final else ""), notes


def unmerge_block(path: Path, text: str, records: dict, created: bool) -> tuple[str | None, list[str]]:
    """Lines berkeDark added (the include in foot.ini): taken out again."""
    lines, nl, final = split_lines(text)
    notes = []
    for name, rec in records.items():
        added, n = rec["added"], len(rec["added"])
        at = next((i for i in range(len(lines) - n + 1) if n and lines[i:i + n] == added), None)
        if at is not None:
            del lines[at:at + n]
        elif rec["added"] and rec["line"] in lines:
            lines.remove(rec["line"])
        elif rec["added"]:
            notes.append(f"the {name} line is gone already")
    if created and not any(line.strip() for line in lines):
        return None, notes
    return nl.join(lines) + (nl if lines and final else ""), notes


UNMERGE = {"json": unmerge_json, "toml": unmerge_toml, "line": unmerge_line, "block": unmerge_block}


# ---------------------------------------------------------------- the targets

def foot_shell(text: str) -> str | None:
    """The last shell= of the [main] section of a foot.ini, or None."""
    section, value = "main", None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        header = re.match(r"^\[\s*([^\]]+?)\s*\]", line)
        if header:
            section = header.group(1)
            continue
        name, equals, rest = line.partition("=")
        if section == "main" and equals and name.strip() == "shell":
            value = re.sub(r"\s+#.*$", "", rest).strip()
    return value


def login_shell() -> str:
    """$SHELL, else the account's shell, else /bin/sh. foot sets SHELL to the first word of its own shell= line,
    which for berkeDark's line is /bin/sh, so /bin/sh in $SHELL asks the account first."""
    shell = os.environ.get("SHELL") or ""
    if shell and shell != "/bin/sh":
        return shell
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_shell or shell or "/bin/sh"
    except (ImportError, KeyError):
        return shell or "/bin/sh"


def system_foot_ini() -> Path | None:
    """The foot.ini foot reads when the user has none (it would read no other once the user has one)."""
    for folder in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":"):
        if folder and (Path(folder) / "foot/foot.ini").is_file():
            return Path(folder) / "foot/foot.ini"
    return None


def install_terminal(tree: Path, record: Record) -> int:
    print("terminal: berkeDark's colour interpreter and foot's palette")
    failed = 0
    cc = os.environ.get("CC", "clang")
    if shutil.which(cc) is None:
        say("NOT DONE", "~/.local/bin/berkeDark", f"{cc} was not found; install clang or set CC")
        failed += 1
    else:
        done = subprocess.run(["sh", str(tree / "terminal/build.sh")], capture_output=True, text=True)
        if done.returncode != 0:
            say("NOT DONE", "~/.local/bin/berkeDark", "the build failed: " + (done.stderr or done.stdout).strip()[:200])
            failed += 1
        else:
            path = HOME / ".local/bin/berkeDark"
            say(record.write("terminal", path, (tree / "terminal/build/berkeDark").read_bytes(), executable=True), path)
    if shutil.which("foot") is None and not (CONFIG / "foot").exists():
        say("skipped", CONFIG / "foot", "foot is not installed; run programs as: berkeDark PROGRAM")
        return failed
    foot_dir = CONFIG / "foot"
    main = foot_dir / "foot.ini"
    own = foot_dir / "berkeDark.ini"
    include = f"include={own}"
    real_main = real_path(main)
    text = read_text(real_main) if real_main.exists() else None

    # berkeDark's file: its colours and cursor, and the user's own shell inside the colour interpreter.
    ini, note = [], None
    for line in read_text(tree / "terminal/config/foot.ini").splitlines():
        if line.startswith("shell="):
            theirs = foot_shell(text or "")
            if theirs and "berkeDark" in theirs:  # their shell= already starts the interpreter: kept as it is
                line = "shell=" + theirs
            elif "'" in (theirs or login_shell()):
                note = "foot.ini's shell= has quotes, so berkeDark leaves the shell alone; run programs as: berkeDark PROGRAM"
                continue
            else:
                line = line.replace("@SHELL@", theirs or login_shell())
        ini.append(line)
    ini = "\n".join(ini) + "\n"

    if text is not None and include in split_lines(text)[0]:
        new, added = text, []
    elif text is None:  # a new foot.ini would hide the system's one: it comes in first
        system = system_foot_ini()
        added = ([f"include={system}", ""] if system else []) + ["[main]", include]
        new = "\n".join(added) + "\n"
    else:
        nl = split_lines(text)[1]
        added = ["", "[main]", include]
        new = text + ("" if not text or text.endswith("\n") else nl) + nl.join(added) + nl
    if shutil.which("foot") and not record.dry:
        with tempfile.TemporaryDirectory(dir=tree.parent) as probe:
            Path(probe, "berkeDark.ini").write_text(ini, encoding="utf-8")
            Path(probe, "foot.ini").write_text(new.replace(include, f"include={probe}/berkeDark.ini"), encoding="utf-8")
            done = subprocess.run(["foot", "-c", f"{probe}/foot.ini", "--check-config"], capture_output=True, text=True)
        if done.returncode != 0:
            say("NOT CHANGED", main, "foot does not accept the result; nothing changed: " + (done.stderr or done.stdout).strip()[:200])
            return failed + 1
    say(record.write("terminal", own, ini.encode()), own, note or "")
    say(record.write("terminal", main, new.encode(), edit=("block", {"include": {"added": added, "line": include}})),
        main, "one include line")
    return failed


def check_qwen_theme(data: bytes):
    theme = json.loads(data)

    def walk(value, where):
        if isinstance(value, dict):
            for k, v in value.items():
                walk(v, f"{where}.{k}")
        elif isinstance(value, list):
            if not value:
                raise Refusal(f"Qwen Code theme: {where} is empty")
            for i, v in enumerate(value):
                walk(v, f"{where}[{i}]")
        elif not (isinstance(value, str) and value.strip()):
            raise Refusal(f"Qwen Code theme: {where} is empty; Qwen Code would drop it silently")
    walk(theme, "theme")


