REPO = Path(__file__).resolve().parent
HOME = Path.home()
TARGETS = ["terminal", "claude", "qwen", "codex", "grok", "ohmyzsh", "vscode"]
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "berkeDark"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
SETTINGS_FILE = CONFIG / "berkeDark" / "berkeDark.toml"

