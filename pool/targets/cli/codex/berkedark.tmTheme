	<string>berkeDark</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>@{bg:base.background}</string>
				<key>foreground</key>
				<string>@{base.text}</string>
				<key>caret</key>
				<string>@{base.cursor}</string>
				<key>selection</key>
				<string>@{bg:base.selection}</string>
				<key>lineHighlight</key>
