			<string>Signs that join commands</string>
			<key>scope</key>
			<string>keyword.operator.logical.pipe.shell, keyword.operator.logical.and.shell, keyword.operator.logical.or.shell, keyword.operator.assignment.redirection.shell, keyword.operator.logical.continue.shell</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>@{command.operator}</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
