    "editor.selectionBackground": "@{kept:vscode.workbench:editor.selectionBackground}",
    "editor.selectionHighlightBackground": "@{kept:vscode.workbench:editor.selectionHighlightBackground}",
    "editor.lineHighlightBackground": "@{kept:vscode.workbench:editor.lineHighlightBackground}",
