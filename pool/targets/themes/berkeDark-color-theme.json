      "fontStyle": ""
    },
    "interface": {
      "foreground": "@{code.type}",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "@{code.type}",
      "fontStyle": ""
    },
    "enum": "@{code.type}",
    "enumMember": "@{code.enum-member}",
    "type": {
      "foreground": "@{code.type}",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "@{code.type}",
      "fontStyle": ""
    },
    "namespace": "@{code.namespace}",
    "decorator": {
