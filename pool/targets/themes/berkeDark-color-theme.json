    "terminal.ansiBrightMagenta": "@{kept:vscode.workbench:terminal.ansiBrightMagenta}",
    "terminal.ansiBrightCyan": "@{kept:vscode.workbench:terminal.ansiBrightCyan}",
    "terminal.ansiBrightWhite": "@{kept:vscode.workbench:terminal.ansiBrightWhite}",

    "editorLineNumber.foreground": "@{kept:vscode.workbench:editorLineNumber.foreground}",
    "editorLineNumber.activeForeground": "@{kept:vscode.workbench:editorLineNumber.activeForeground}",
